{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-wrapper.sh"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/message.oga 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "model": "opus",
  "autoCompactEnabled": false,
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "wip-list@wip-list": true
  },
  "extraKnownMarketplaces": {
    "wip-list": {
      "source": {
        "source": "github",
        "repo": "LeoJhonSong/WIP-list"
      },
      "autoUpdate": true
    }
  }
}
